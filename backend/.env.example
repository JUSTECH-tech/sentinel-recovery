# Copy this file to .env and edit it. Never commit .env.

PORT=8787
HOST=0.0.0.0

# Folder for the database and evidence. Leave blank for ./data.
# On Render, set this to /data so it uses the persistent disk.
DATA_DIR=

# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,https://justech-tech.github.io

# Public URL of this API (used in links). No trailing slash.
BASE_URL=http://localhost:8787

# Where admin alert emails go.
NOTIFICATION_EMAIL=alyshiakelly6@gmail.com

# Admin login password. If left blank, a random one is generated on first start
# and printed to the console once. Recommended: set a long unique password here.
ADMIN_PASSWORD=

# Optional: Resend API key for acknowledgement + alert emails.
# Get one at https://resend.com/api-keys. Leave blank to disable email.
RESEND_API_KEY=
EMAIL_FROM=Sentinel Recovery <onboarding@resend.dev>

# Optional: random string used to hash visitor IP addresses in the database.
IP_SALT=change-this-to-a-long-random-string
